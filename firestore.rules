rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && (request.auth.token.email == 'nks00@nks-fukuoka.app'
          || request.auth.token.email == 'nkstaco@nks-fukuoka.app'
          || request.auth.token.email == 'nkstuna@nks-fukuoka.app');
    }

    match /fukuoka_tasks/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /fukuoka_info/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /fukuoka_itinerary/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /fukuoka_expenses/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /fukuoka_members/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /fukuoka_checklists/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /fukuoka_ledger/{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
